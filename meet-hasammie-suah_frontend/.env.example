# API URL — points to the GraphQL backend
# Development (local Docker)
VITE_API_URL=http://localhost:4000/graphql

# Production (your Hostinger domain)
# VITE_API_URL=https://api.yourdomain.com/graphql

# ── Posthog analytics (optional) ──────────────────────────────────────────────
# Leave blank in development — Posthog will not initialise.
# Get your key at https://posthog.com → Project Settings → Project API Key
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
