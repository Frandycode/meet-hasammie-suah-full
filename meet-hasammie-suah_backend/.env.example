# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=sammie
POSTGRES_PASSWORD=change_this_strong_password
POSTGRES_DB=sammie_site

# ── API ───────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://sammie:change_this_strong_password@db:5432/sammie_site
JWT_SECRET=change_this_to_a_long_random_string_at_least_32_chars
ADMIN_PASSWORD=sammie2009
PORT=4000
NODE_ENV=production

# ── URLs ──────────────────────────────────────────────────────────────────────
# Local development
API_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# Production — replace with your actual Hostinger domain
# API_BASE_URL=https://api.yourdomain.com
# FRONTEND_URL=https://yourdomain.com

# ── Cloudinary (optional — leave blank to use local storage) ──────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email / Contact form (Resend) ─────────────────────────────────────────────
# Sign up free at https://resend.com — 3,000 emails/month free tier
# Leave blank in development — emails will be logged to console instead
RESEND_API_KEY=
# The inbox that receives contact form messages
CONTACT_TO_EMAIL=sammie@example.com
# The "From" address — must match a verified domain in Resend
CONTACT_FROM_EMAIL=noreply@meethasammiesuah.com
